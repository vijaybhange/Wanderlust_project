<!-- for success partial -->
<% if(success && success.length) {%>
<div class="alert alert-success alert-dismissible fade show mt-2 col-6 offset-3" role="alert" >
  <%= success %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% }%>

<!-- success is an array ...it is showing div even no listing ,cause aaray exits bt inside no value ..so that we use -- && success.length  -->

<!-- for failure partial -->
 <% if(error && error.length) {%>
<div class="alert alert-danger alert-dismissible fade show mt-2 col-6 offset-3" role="alert" >
  <%= error %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% }%>